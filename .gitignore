code/alveo/_x/
*.xclbin
*.xclbin.info
*.xo
*.dcp
*.ltx

# Vivado scratch + synthesis run dirs
.Xil/
code/verilog/synth/.Xil/

# XSim simulation output
xsim.dir/
*.wdb
*.jou
*.pb
*.str
xelab.log
xvlog.log
xsim.log

# Waveforms (*.vcd already covered above)
*.ghw
